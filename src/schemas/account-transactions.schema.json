{
  "$schema": "https://json-schema.org",
  "title": "AccountTransactionsRequest",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "properties": {
      "source_account": { "type": "string" },
      "currency": { "type": "string" },
      "transactions": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "properties": {
            "destination_account": { "type": "string" },
            "transaction_type": { "type": "string", "enum": ["transfer", "payment"] },
            "amount": { "type": "number" },
            "foreign_amount": { "type": "number" },
            "foreign_currency": { "type": "string" },
            "date": { "type": "string", "format": "date" },
            "description": { "type": "string" },
            "notes": { "type": "string" }
          },
          "required": ["destination_account", "transaction_type", "amount", "date", "description"],
          "dependencies": {
            "foreign_amount": ["foreign_currency"],
            "foreign_currency": ["foreign_amount"]
          },
          "additionalProperties": false
        }
      }
    },
    "required": ["source_account", "currency", "transactions"],
    "additionalProperties": false
  }
}
